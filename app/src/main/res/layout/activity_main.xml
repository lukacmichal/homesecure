<?xml version="1.0" encoding="utf-8"?>
<!--
  Paticka s verziou je MIMO ScrollView, aby drzala uplne dole na obrazovke
  a nerolovala s obsahom - rovnako ako vo vsetkych ostatnych appkach.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    android:id="@+id/potiahni"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:id="@+id/hlavicka_nazov"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Spolocne ikony hlavicky (docs/shared-standard.md 2.6). Nastavenia boli do
                 20. 8. 2026 velke tlacidlo dole v obsahu, v kazdej appke inde. -->
            <ImageButton
                android:id="@+id/obnov"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/obnovit"
                android:src="@drawable/ic_obnovit" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nastavenia"
                android:src="@drawable/ic_nastavenia" />
        </LinearLayout>

        <!-- Stav -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/state_paused"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Hlavny prepinac -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stráženie"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Co treba dopovolit -->
        <LinearLayout
            android:id="@+id/cardWarnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ešte treba dopovoliť"
                android:textColor="@color/warn"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWarnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/warnButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_ghost_bg"
            android:stateListAnimator="@null"
            android:text="Test: odfoť a pošli mail"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnPing"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_ghost_bg"
            android:stateListAnimator="@null"
            android:text="Test: nájdi moje zariadenia"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_ghost_bg"
            android:stateListAnimator="@null"
            android:text="Skontrolovať aktualizáciu na NAS-e"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Denník"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="vyčistiť"
                android:textColor="@color/accent"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:textColor="@color/text_dim"
            android:textIsSelectable="true"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Spolocna paticka s verziou (docs/shared-standard.md 2.6) - rovnaky blok vo vsetkych appkach. -->
    <TextView
        android:id="@+id/verFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="@color/ver_text"
        android:textSize="11sp" />
</LinearLayout>
