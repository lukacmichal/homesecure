    <color name="surface">#FF0E1216</color>
    <color name="text">#FFE8EDF2</color>
    <color name="text_dim">#FF8C99A8</color>
    <color name="accent">#FF4F9BFF</color>
    <color name="ok">#FF3FD68C</color>
    <color name="warn">#FFE8B23A</color>
    <color name="alarm">#FFF05C61</color>
    <color name="icon_bg">#FF000000</color>

    <color name="ver_text">#FF8C99A8</color>
