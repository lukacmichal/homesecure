        android:scaleX="2.15"
        android:scaleY="2.15"
        android:translateX="28.2"
        android:translateY="26.8">

        <!-- Jemny podsvit pod stitom. -->
        <path
            android:pathData="M12,1.2 L21.2,4.6 V11.6 C21.2,17.8 17.2,23.4 12,24.8 C6.8,23.4 2.8,17.8 2.8,11.6 V4.6 Z"
