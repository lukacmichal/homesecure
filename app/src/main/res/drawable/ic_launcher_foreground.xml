                    android:type="linear"
                    android:startX="3.5" android:startY="2"
                    android:endX="20.5" android:endY="23.4">
                    <item android:offset="0" android:color="#FF5AA9FF" />
                    <item android:offset="1" android:color="#FF2563D9" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Domcek vyrezany v stite. -->
