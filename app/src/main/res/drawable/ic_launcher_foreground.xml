    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Stit + domcek. Kresli sa v 24x24 mriezke a skaluje sa do bezpecnej zony
        adaptivnej ikony (stred 66 z 108 dp), aby ju launcher neorezal.
    -->
