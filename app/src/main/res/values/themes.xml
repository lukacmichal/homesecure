<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- DayNight, nie obycajna AppCompat: appka je tmava od zaciatku, ale od
         28. 8. 2026 ma aj CIERNY rezim (values-night) kvoli vydrzi baterie
         na OLED. Bez DayNight by sa nocna paleta nikdy nepouzila. -->
    <!--
      Bez opt-outu Android 15+ kresli appku s targetSdk 35 pod stavovu listu
      a navigaciu (nadpis pod hodinami, paticka pod gestom). docs/shared-standard.md 2.6.
    -->
    <style name="Theme.HomeSecure" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/bg</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/bg</item>
    </style>

    <!-- Trampolina sa nesmie na obrazovke nijako prejavit. -->
    <style name="Theme.HomeSecure.Invisible" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
